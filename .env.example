# --- Twitch (requerido) ---
TWITCH_CHANNEL="Tu canal de Twitch (ej: maichanpy)"
TWITCH_TOKEN="Tu Twitch OAuth Token"
BOT_NAME="Neuro-Sama"

# --- Ollama (LLM local) ---
# Modelo de Ollama. Elegí uno acorde a tu VRAM:
#   qwen2.5:3b  -> ~2GB, entra en GPUs de 6GB (recomendado para GTX 1660, etc.)
#   qwen2.5:7b  -> ~4.7GB
#   qwen2.5:14b -> ~9GB (necesita >=12GB de VRAM para ir 100% en GPU)
OLLAMA_MODEL="qwen2.5:3b"

# --- TTS (motor de voz) ---
# Motor de Text-To-Speech a usar:
#   edge  -> Edge TTS (online, voces de Microsoft). Por defecto.
#   piper -> Piper TTS (100% offline, requiere los modelos en models/tts/).
TTS_ENGINE="edge"

# --- VTube Studio ---
# Puerto de la API de VTube Studio (por defecto 8001). Cambialo si ese puerto
# está ocupado por otra app (ej: Docker/OpenKM).
VTS_PORT=8001

# --- Visión (módulo screen_vision: Mai-chan "ve" la pantalla y reacciona) ---
# Los DEFAULTS apuntan a producción (RTX 3090 24GB). Para desarrollar en una GPU
# chica (ej: GTX 1660 6GB), descomentá los valores "dev" de cada línea.
#
# Host de Ollama (si corre en otra máquina/WSL2, cambiá la IP/puerto).
OLLAMA_HOST="http://127.0.0.1:11434"
# Modelo de visión (VLM). USÁ LA VARIANTE -instruct: la genérica (qwen3-vl:4b)
# es *thinking* y se cuelga razonando sin emitir la descripción.
#   PROD 3090: qwen3-vl:8b-instruct   (requiere Ollama >= 0.30)
#   DEV  6GB : qwen3-vl:4b-instruct   (~2.8s en caliente; respaldo: llava:7b)
VISION_VLM_MODEL="qwen3-vl:8b-instruct"
# Cada cuántos segundos mira la pantalla. PROD: 3   DEV: 6
VISION_INTERVAL_SECONDS=3
# Tokens máximos de salida del VLM (más bajo = menos latencia). PROD: 128  DEV: 64
VISION_NUM_PREDICT=128
# Ancho al que se reduce el frame antes de enviarlo al VLM.
VISION_MAX_WIDTH=1280
# Sensibilidad al cambio de escena (0-100): más alto = comenta menos seguido.
VISION_SCENE_THRESHOLD=6
# Modo de prompt: "describe" (objetivo, 2 etapas — recomendado integrado) |
# "react" (el VLM comenta directo, 1 etapa — atajo para demos)
VISION_PROMPT_MODE="describe"
# ¿Mai-chan mira la pantalla mientras corre el bot? (true para integrarla al
# pipeline; el prototipo standalone NO usa esta var). Requiere un VLM disponible.
VISION_ENABLED=false

# --- MediaController (que el audio del video no pise la voz de Mai-chan) ---
# Pausa o baja el volumen del contenido mientras Mai-chan habla. Nivel 1 (solo
# simula inputs del sistema). Apagado por defecto.
MEDIA_CONTROL_ENABLED=false
# Fuente del contenido -> técnica:
#   gameplay          -> no corta (narra en vivo)
#   navegador         -> ducking (baja el volumen del navegador)
#   reproductor_local -> pausa   (tecla multimedia, ideal pelis/series)
MEDIA_SOURCE="navegador"
# Proceso cuyo volumen se baja al hacer ducking (chrome.exe, msedge.exe, vlc.exe).
MEDIA_DUCK_PROCESS="chrome.exe"
# A cuánto se baja el volumen del video al hablar (0.0-1.0).
MEDIA_DUCK_LEVEL=0.2
# Fallback cuando el VAD de loopback está apagado/no disponible: asumir que el
# video tiene diálogo (pausa/duckea). Poné false si el contenido es música/acción
# y querés hablar encima sin cortar.
MEDIA_ASSUME_DIALOGO=true
# VAD de loopback: en vez de asumir, DETECTAR en vivo si el video tiene voz.
# Captura el audio del sistema (loopback WASAPI, vía pyaudiowpatch) y lo pasa por
# Silero VAD (el que ya trae faster-whisper). Si hay voz → corta; si es música/
# acción/silencio → habla encima. Apagado por defecto; manda sobre ASSUME_DIALOGO
# solo cuando logra arrancar (si no, cae al fallback de arriba). Solo Windows.
MEDIA_VAD_ENABLED=false
# Umbral de Silero (0.0-1.0): + alto = corta menos (menos falsos positivos).
MEDIA_VAD_THRESHOLD=0.5
# Segundos que sostiene el "hay voz" tras la última palabra (anti-parpadeo).
MEDIA_VAD_HOLD_SECONDS=1.5

# --- Modo de atención (cómo prioriza Mai-chan chat vs video) ---
# Decide a qué le da bola primero cuando hay cosas compitiendo en la cola.
# Cambiable en vivo con el comando "!mode video|chat|hybrid" (solo el dueño).
#   VIDEO_FIRST -> prioriza reaccionar al video; el chat espera huecos
#   CHAT_FIRST  -> prioriza el chat; comenta el video en silencios
#   HYBRID      -> chat y video compiten parejo (default)
# (El micro del streamer va siempre primero en todos los modos.)
ATTENTION_MODE="HYBRID"

# --- Autonomía (director loop) ---
# Cuando hay silencio (nada en chat/voz/pantalla), Mai-chan habla sola: retoma su
# plan del día (ver comando !agenda) o suelta un comentario. Apagado por defecto.
DIRECTOR_ENABLED=false
# Cada cuántos segundos de silencio actúa el director.
DIRECTOR_INTERVAL_SECONDS=45
